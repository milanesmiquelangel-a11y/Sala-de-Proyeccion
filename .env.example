# IA
POLLINATIONS_API_KEY=PEGA_AQUI_TU_CLAVE_DE_POLLINATIONS

# Servidor
PORT=3000
NODE_ENV=production
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
